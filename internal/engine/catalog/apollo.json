{
  "id": "apollo",
  "name": "Apollo",
  "featured": true,
  "vendor": "Tsinghua University · Tencent AI Lab",
  "description": "Restores music damaged by lossy compression: rebuilds the highs and the air that low-bitrate MP3 and streaming encodes take away.",
  "homepage": "https://github.com/JusperLee/Apollo",
  "license": "CC BY-SA 4.0",
  "tags": ["GAN", "Music", "Restoration", "PyTorch"],
  "requirements": "Python 3.10+ · NVIDIA GPU or Apple Silicon recommended",
  "media": ["audio"],
  "input": "audio",
  "inputRate": 44100,
  "install": {
    "type": "pip",
    "size": "≈ 3 GB with PyTorch, plus the model",
    "source": {"url": "https://github.com/JusperLee/Apollo/archive/e84bcacc59d5455f05d86a5c97dd4aeb3c14dbb6.zip", "dir": "src"},
    "pip": [
      {
        "args": ["torch>=2.7", "torchaudio"],
        "indexURL": {"windows": "https://download.pytorch.org/whl/cu128"}
      },
      {"args": ["numpy", "huggingface-hub", "omegaconf", "soundfile"]}
    ],
    "scripts": ["apollo_launch.py"]
  },
  "executable": {"*": "python"},
  "args": [
    "{engineDir}/apollo_launch.py",
    "{engineDir}/src/inference.py",
    "--in_wav",
    "{input}",
    "--out_wav",
    "{output}",
    "--checkpoint",
    "{modelPath}",
    "--device",
    "auto",
    "--overlap-seconds",
    "1",
    "--chunk-pad-seconds",
    "1"
  ],
  "outputExt": ".wav",
  "models": [
    {
      "id": "official",
      "name": "Apollo",
      "description": "The official checkpoint, trained on MUSDB18-HQ and MoisesDB.",
      "recommended": true,
      "files": [
        {"url": "https://huggingface.co/JusperLee/Apollo/resolve/main/pytorch_model.bin", "name": "apollo/pytorch_model.bin"}
      ]
    }
  ],
  "options": [
    {
      "id": "chunk",
      "name": "Chunk length",
      "type": "choice",
      "default": "5",
      "description": "Seconds of audio processed at a time. Longer chunks are a little faster but need more GPU memory: 5 s suits 8–12 GB cards. When the GPU runs out of memory, TouchUp halves the chunk and carries on.",
      "choices": [
        {"value": "3", "label": "3 s"},
        {"value": "5", "label": "5 s"},
        {"value": "10", "label": "10 s"},
        {"value": "20", "label": "20 s"},
        {"value": "30", "label": "30 s"}
      ],
      "args": ["--chunk-seconds", "{value}"]
    }
  ]
}
